# Copie para .env e preencha. Nunca publique este arquivo.
PORT=3000
NODE_ENV=production
BASE_URL=https://seu-dominio.com.br

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Supabase > Project Settings > Database > Connection string (URI)
DATABASE_URL=
DATABASE_SSL=true

# Mercado Pago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_WEBHOOK_URL=https://seu-dominio.com.br/api/webhooks/mercadopago

# Resend (recuperação de senha)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ===== IA (treino e cardápio para assinantes Premium) =====
# Escolha "openai" ou "gemini" e preencha SOMENTE a chave do provedor escolhido.
# A chave fica apenas no servidor; nunca coloque no index.html.
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
# Opcional: modelo (padrão gpt-6-luna na OpenAI e gemini-3.5-flash-lite no Gemini)
AI_MODEL=
# Opcional: planos com IA por assinante por dia (padrão 3, máximo 50)
AI_DAILY_LIMIT=3
